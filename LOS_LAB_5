•	Print the fifth log entry.
sed -n '5p' auth.log
•	Print entries from lines 2 to 6.
sed -n '2,6p' auth.log
•	Print the last entry.
sed -n '$p' auth.log
•	Print every second log entry starting from line 1.
sed -n '1~2p' auth.log
•	Print all entries containing Failed password.
